generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum EventVisibility {
  SHARED
  PRIVATE
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
}

enum InvestmentClass {
  FIXED_INCOME
  TREASURY
  STOCKS
  REITS
  FUNDS
  CRYPTO
  PENSION
  OTHER
}

/// How an investment's value is estimated between manual valuations.
enum YieldMode {
  /// Post-fixed: `rate` is a percentage of the CDI (e.g. 110 = 110% do CDI).
  CDI_PERCENT
  /// Pre-fixed: `rate` is % per year over 252 business days.
  FIXED_RATE
  /// IPCA + `rate`% per year.
  IPCA_PLUS
  /// Market-priced (stocks, crypto...): value comes only from valuations.
  MANUAL
}

enum MarketSeries {
  /// Daily CDI rate, % per day (BCB SGS 12).
  CDI
  /// Monthly IPCA, % per month (BCB SGS 433).
  IPCA
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  membership          HouseholdMember?
  createdTransactions Transaction[]
  createdInvites      HouseholdInvite[]     @relation("InviteCreator")
  createdTransfers    Transfer[]
  createdRecurring    RecurringRule[]
  createdGoals        Goal[]
  goalContributions   GoalContribution[]
  createdEvents       CalendarEvent[]
  createdValuations   InvestmentValuation[]
  calendarSharesA     CalendarShare[]       @relation("ShareUserA")
  calendarSharesB     CalendarShare[]       @relation("ShareUserB")
  calendarInvites     CalendarInvite[]
  ownedAccounts       Account[]             @relation("AccountOwner")
  ownedCategories     Category[]            @relation("CategoryOwner")
  passwordResets      PasswordResetToken[]

  @@map("users")
}

/// One row per active session. Only the SHA-256 hash of the token is stored,
/// so a leaked database never exposes usable refresh tokens.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// A household ("lar") owns all financial data. Every user belongs to exactly
/// one: a personal one by default, or a shared one (e.g. a couple) after
/// accepting an invite. Data isolation (BOLA) is enforced per household.
model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      HouseholdMember[]
  invites      HouseholdInvite[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  accounts     Account[]
  transfers    Transfer[]
  recurring    RecurringRule[]
  goals        Goal[]
  events       CalendarEvent[]
  investments  Investment[]
  valuations   InvestmentValuation[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @db.Uuid
  /// Unique: a user is in exactly one household at a time.
  userId      String        @unique @db.Uuid
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_members")
}

/// Single-use invite code. Only its SHA-256 is stored (like refresh tokens).
model HouseholdInvite {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  codeHash    String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_invites")
}

model Category {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  type        TransactionType
  color       String?
  icon        String?
  householdId String          @db.Uuid
  /// Who brought it to the household: goes back with them if they leave. Null = shared.
  ownerId     String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner        User?           @relation("CategoryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringRule[]

  @@unique([householdId, name, type])
  @@index([householdId, type])
  @@map("categories")
}

model Transaction {
  id                 String          @id @default(uuid()) @db.Uuid
  description        String
  /// Money is never stored as float: NUMERIC(14,2) is exact.
  amount             Decimal         @db.Decimal(14, 2)
  type               TransactionType
  date               DateTime        @db.Date
  notes              String?
  categoryId         String          @db.Uuid
  accountId          String          @db.Uuid
  householdId        String          @db.Uuid
  /// Who registered it (shown in shared households). Kept if the user leaves.
  createdById        String?         @db.Uuid
  /// Installment purchases: N transactions sharing a group id ("3/10").
  installmentGroupId String?         @db.Uuid
  installmentNumber  Int?
  installmentTotal   Int?
  /// Set when generated by a recurring rule (unique per rule and date).
  recurringRuleId    String?         @db.Uuid
  /// Bank id of an imported entry (OFX FITID): re-importing never duplicates.
  externalId         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Restrict: a category with transactions cannot be deleted by accident.
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Restrict: an account with history must be archived, not deleted.
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  /// Idempotent generation: a rule can produce at most one entry per date.
  @@unique([recurringRuleId, date])
  @@unique([accountId, externalId])
  /// Covering index: listing (householdId + date order) and every report
  /// aggregate are answered from the index alone. See LOAD_TESTING.md.
  @@index([householdId, date, type, categoryId, amount], map: "transactions_household_date_covering_idx")
  @@index([householdId, categoryId])
  @@index([householdId, accountId])
  @@index([installmentGroupId])
  @@map("transactions")
}

model Budget {
  id           String   @id @default(uuid()) @db.Uuid
  monthlyLimit Decimal  @db.Decimal(14, 2)
  year         Int
  month        Int
  categoryId   String   @db.Uuid
  householdId  String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, year, month])
  @@index([householdId, year, month])
  @@map("budgets")
}

/// Where the money is: checking account, credit card, cash, savings...
model Account {
  id             String      @id @default(uuid()) @db.Uuid
  householdId    String      @db.Uuid
  name           String
  type           AccountType
  color          String?
  icon           String?
  initialBalance Decimal     @default(0) @db.Decimal(14, 2)
  /// Archived accounts keep their history but take no new entries.
  archived       Boolean     @default(false)
  /// Who brought it to the household: goes back with them if they leave. Null = shared.
  ownerId        String?     @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner        User?           @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  transfersOut Transfer[]      @relation("TransferFrom")
  transfersIn  Transfer[]      @relation("TransferTo")
  recurring    RecurringRule[] @relation("RecurringFrom")
  recurringIn  RecurringRule[] @relation("RecurringTo")
  investment   Investment?

  @@index([householdId])
  @@map("accounts")
}

/// Money moving between two accounts of the household (e.g. paying the credit
/// card bill). Kept apart from transactions so it never counts as income or
/// expense in reports.
model Transfer {
  id              String   @id @default(uuid()) @db.Uuid
  householdId     String   @db.Uuid
  fromAccountId   String   @db.Uuid
  toAccountId     String   @db.Uuid
  amount          Decimal  @db.Decimal(14, 2)
  date            DateTime @db.Date
  description     String?
  createdById     String?  @db.Uuid
  /// Set when generated by a recurring rule (one per rule and date).
  recurringRuleId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromAccount   Account        @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account        @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@unique([recurringRuleId, date])
  @@index([householdId, date])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

/// "Salary every 5th", "Netflix every month", "IPVA every year".
/// Due occurrences become real transactions on demand (see RecurringService).
model RecurringRule {
  id          String              @id @default(uuid()) @db.Uuid
  householdId String              @db.Uuid
  description String
  amount      Decimal             @db.Decimal(14, 2)
  type        TransactionType
  frequency   RecurrenceFrequency
  /// Set for income/expense rules; null for transfer rules.
  categoryId  String?             @db.Uuid
  /// Paying account (source of the transfer for transfer rules).
  accountId   String              @db.Uuid
  /// Set for transfer rules, e.g. a monthly contribution to an investment.
  toAccountId String?             @db.Uuid
  notes       String?
  /// Occurrences are computed from this anchor (no drift after short months).
  startDate   DateTime            @db.Date
  endDate     DateTime?           @db.Date
  /// First occurrence not yet turned into a transaction.
  nextRunDate DateTime            @db.Date
  active      Boolean             @default(true)
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account      Account       @relation("RecurringFrom", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount    Account?      @relation("RecurringTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  transactions Transaction[]
  transfers    Transfer[]

  @@index([householdId, active, nextRunDate])
  @@map("recurring_rules")
}

/// A savings goal ("Viagem para o Chile: R$ 12.000 até julho"). Contributions
/// track progress like an envelope; they do not move account balances.
model Goal {
  id           String    @id @default(uuid()) @db.Uuid
  householdId  String    @db.Uuid
  name         String
  targetAmount Decimal   @db.Decimal(14, 2)
  targetDate   DateTime? @db.Date
  color        String?
  icon         String?
  archived     Boolean   @default(false)
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy     User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([householdId])
  @@map("goals")
}

/// Positive = money set aside, negative = withdrawn from the goal.
model GoalContribution {
  id          String   @id @default(uuid()) @db.Uuid
  goalId      String   @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  date        DateTime @db.Date
  note        String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  goal      Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([goalId, date])
  @@map("goal_contributions")
}

/// Household calendar. SHARED events show up for every member (dinner on
/// Friday at 22:00 for both); PRIVATE ones exist only for their creator.
model CalendarEvent {
  id            String          @id @default(uuid()) @db.Uuid
  householdId   String          @db.Uuid
  createdById   String?         @db.Uuid
  title         String
  description   String?
  location      String?
  /// Absolute instants (timestamptz); clients send ISO 8601 with offset.
  startAt       DateTime        @db.Timestamptz(3)
  endAt         DateTime        @db.Timestamptz(3)
  allDay        Boolean         @default(false)
  visibility    EventVisibility @default(SHARED)
  color         String?
  estimatedCost Decimal?        @db.Decimal(14, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([householdId, startAt])
  @@map("calendar_events")
}

/// Investment profile of an account: how its value grows and what it is.
model Investment {
  id           String          @id @default(uuid()) @db.Uuid
  householdId  String          @db.Uuid
  accountId    String          @unique @db.Uuid
  assetClass   InvestmentClass
  yieldMode    YieldMode
  /// % of CDI (CDI_PERCENT) or % per year (FIXED_RATE, IPCA_PLUS); null for MANUAL.
  rate         Decimal?        @db.Decimal(8, 4)
  /// Date of the account's initial balance (when the money was already invested).
  startDate    DateTime        @db.Date
  maturityDate DateTime?       @db.Date
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  household  Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account    Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  valuations InvestmentValuation[]

  @@index([householdId])
  @@map("investments")
}

/// Market value read from the broker/bank statement on a given day.
model InvestmentValuation {
  id           String   @id @default(uuid()) @db.Uuid
  householdId  String   @db.Uuid
  investmentId String   @db.Uuid
  date         DateTime @db.Date
  value        Decimal  @db.Decimal(14, 2)
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([investmentId, date])
  @@index([householdId])
  @@map("investment_valuations")
}

/// Public market rates cached from Banco Central (shared by everyone).
model MarketRate {
  series MarketSeries
  date   DateTime     @db.Date
  /// CDI: % per day; IPCA: % per month (dated on the 1st).
  rate   Decimal      @db.Decimal(12, 8)

  @@id([series, date])
  @@map("market_rates")
}

/// Two people who see each other's shared events, without sharing finances.
/// Stored once per pair, with userAId < userBId.
model CalendarShare {
  id        String   @id @default(uuid()) @db.Uuid
  userAId   String   @db.Uuid
  userBId   String   @db.Uuid
  createdAt DateTime @default(now())

  userA User @relation("ShareUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ShareUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("calendar_shares")
}

/// One-time code to start sharing calendars (only its SHA-256 is stored).
model CalendarInvite {
  id          String    @id @default(uuid()) @db.Uuid
  codeHash    String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@map("calendar_invites")
}

/// One-time password reset link (only its SHA-256 is stored).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
