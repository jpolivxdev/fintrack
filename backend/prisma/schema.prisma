generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum EventVisibility {
  SHARED
  PRIVATE
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  membership          HouseholdMember?
  createdTransactions Transaction[]
  createdInvites      HouseholdInvite[] @relation("InviteCreator")
  createdTransfers    Transfer[]
  createdRecurring    RecurringRule[]
  createdGoals        Goal[]
  goalContributions   GoalContribution[]
  createdEvents       CalendarEvent[]

  @@map("users")
}

/// One row per active session. Only the SHA-256 hash of the token is stored,
/// so a leaked database never exposes usable refresh tokens.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// A household ("lar") owns all financial data. Every user belongs to exactly
/// one: a personal one by default, or a shared one (e.g. a couple) after
/// accepting an invite. Data isolation (BOLA) is enforced per household.
model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      HouseholdMember[]
  invites      HouseholdInvite[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  accounts     Account[]
  transfers    Transfer[]
  recurring    RecurringRule[]
  goals        Goal[]
  events       CalendarEvent[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @db.Uuid
  /// Unique: a user is in exactly one household at a time.
  userId      String        @unique @db.Uuid
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_members")
}

/// Single-use invite code. Only its SHA-256 is stored (like refresh tokens).
model HouseholdInvite {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  codeHash    String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_invites")
}

model Category {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  type        TransactionType
  color       String?
  icon        String?
  householdId String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringRule[]

  @@unique([householdId, name, type])
  @@index([householdId, type])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  description String
  /// Money is never stored as float: NUMERIC(14,2) is exact.
  amount      Decimal         @db.Decimal(14, 2)
  type        TransactionType
  date        DateTime        @db.Date
  notes       String?
  categoryId  String          @db.Uuid
  accountId   String          @db.Uuid
  householdId String          @db.Uuid
  /// Who registered it (shown in shared households). Kept if the user leaves.
  createdById String?         @db.Uuid
  /// Installment purchases: N transactions sharing a group id ("3/10").
  installmentGroupId String?  @db.Uuid
  installmentNumber  Int?
  installmentTotal   Int?
  /// Set when generated by a recurring rule (unique per rule and date).
  recurringRuleId    String?  @db.Uuid
  /// Bank id of an imported entry (OFX FITID): re-importing never duplicates.
  externalId         String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Restrict: a category with transactions cannot be deleted by accident.
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Restrict: an account with history must be archived, not deleted.
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  /// Covering index: listing (householdId + date order) and every report
  /// aggregate are answered from the index alone. See LOAD_TESTING.md.
  @@index([householdId, date, type, categoryId, amount], map: "transactions_household_date_covering_idx")
  @@index([householdId, categoryId])
  @@index([householdId, accountId])
  @@index([installmentGroupId])
  /// Idempotent generation: a rule can produce at most one entry per date.
  @@unique([recurringRuleId, date])
  @@unique([accountId, externalId])
  @@map("transactions")
}

model Budget {
  id           String   @id @default(uuid()) @db.Uuid
  monthlyLimit Decimal  @db.Decimal(14, 2)
  year         Int
  month        Int
  categoryId   String   @db.Uuid
  householdId  String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, year, month])
  @@index([householdId, year, month])
  @@map("budgets")
}

/// Where the money is: checking account, credit card, cash, savings...
model Account {
  id             String      @id @default(uuid()) @db.Uuid
  householdId    String      @db.Uuid
  name           String
  type           AccountType
  color          String?
  icon           String?
  initialBalance Decimal     @default(0) @db.Decimal(14, 2)
  /// Archived accounts keep their history but take no new entries.
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  transfersOut Transfer[]      @relation("TransferFrom")
  transfersIn  Transfer[]      @relation("TransferTo")
  recurring    RecurringRule[]

  @@index([householdId])
  @@map("accounts")
}

/// Money moving between two accounts of the household (e.g. paying the credit
/// card bill). Kept apart from transactions so it never counts as income or
/// expense in reports.
model Transfer {
  id            String   @id @default(uuid()) @db.Uuid
  householdId   String   @db.Uuid
  fromAccountId String   @db.Uuid
  toAccountId   String   @db.Uuid
  amount        Decimal  @db.Decimal(14, 2)
  date          DateTime @db.Date
  description   String?
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromAccount Account   @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account   @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([householdId, date])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

/// "Salary every 5th", "Netflix every month", "IPVA every year".
/// Due occurrences become real transactions on demand (see RecurringService).
model RecurringRule {
  id          String              @id @default(uuid()) @db.Uuid
  householdId String              @db.Uuid
  description String
  amount      Decimal             @db.Decimal(14, 2)
  type        TransactionType
  frequency   RecurrenceFrequency
  categoryId  String              @db.Uuid
  accountId   String              @db.Uuid
  notes       String?
  /// Occurrences are computed from this anchor (no drift after short months).
  startDate   DateTime            @db.Date
  endDate     DateTime?           @db.Date
  /// First occurrence not yet turned into a transaction.
  nextRunDate DateTime            @db.Date
  active      Boolean             @default(true)
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([householdId, active, nextRunDate])
  @@map("recurring_rules")
}

/// A savings goal ("Viagem para o Chile: R$ 12.000 até julho"). Contributions
/// track progress like an envelope; they do not move account balances.
model Goal {
  id           String    @id @default(uuid()) @db.Uuid
  householdId  String    @db.Uuid
  name         String
  targetAmount Decimal   @db.Decimal(14, 2)
  targetDate   DateTime? @db.Date
  color        String?
  icon         String?
  archived     Boolean   @default(false)
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy     User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([householdId])
  @@map("goals")
}

/// Positive = money set aside, negative = withdrawn from the goal.
model GoalContribution {
  id          String   @id @default(uuid()) @db.Uuid
  goalId      String   @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  date        DateTime @db.Date
  note        String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  goal      Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([goalId, date])
  @@map("goal_contributions")
}

/// Household calendar. SHARED events show up for every member (dinner on
/// Friday at 22:00 for both); PRIVATE ones exist only for their creator.
model CalendarEvent {
  id            String          @id @default(uuid()) @db.Uuid
  householdId   String          @db.Uuid
  createdById   String?         @db.Uuid
  title         String
  description   String?
  location      String?
  /// Absolute instants (timestamptz); clients send ISO 8601 with offset.
  startAt       DateTime        @db.Timestamptz(3)
  endAt         DateTime        @db.Timestamptz(3)
  allDay        Boolean         @default(false)
  visibility    EventVisibility @default(SHARED)
  color         String?
  estimatedCost Decimal?        @db.Decimal(14, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([householdId, startAt])
  @@map("calendar_events")
}
