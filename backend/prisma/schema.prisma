generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]

  @@map("users")
}

/// One row per active session. Only the SHA-256 hash of the token is stored,
/// so a leaked database never exposes usable refresh tokens.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  type      TransactionType
  color     String?
  icon      String?
  userId    String          @db.Uuid
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  description String
  /// Money is never stored as float: NUMERIC(14,2) is exact.
  amount      Decimal         @db.Decimal(14, 2)
  type        TransactionType
  date        DateTime        @db.Date
  notes       String?
  categoryId  String          @db.Uuid
  userId      String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: a category with transactions cannot be deleted by accident.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@map("transactions")
}

model Budget {
  id           String   @id @default(uuid()) @db.Uuid
  monthlyLimit Decimal  @db.Decimal(14, 2)
  year         Int
  month        Int
  categoryId   String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, year, month])
  @@index([userId, year, month])
  @@map("budgets")
}
