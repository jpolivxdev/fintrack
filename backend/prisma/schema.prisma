generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum HouseholdRole {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  membership          HouseholdMember?
  createdTransactions Transaction[]
  createdInvites      HouseholdInvite[] @relation("InviteCreator")

  @@map("users")
}

/// One row per active session. Only the SHA-256 hash of the token is stored,
/// so a leaked database never exposes usable refresh tokens.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// A household ("lar") owns all financial data. Every user belongs to exactly
/// one: a personal one by default, or a shared one (e.g. a couple) after
/// accepting an invite. Data isolation (BOLA) is enforced per household.
model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      HouseholdMember[]
  invites      HouseholdInvite[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @db.Uuid
  /// Unique: a user is in exactly one household at a time.
  userId      String        @unique @db.Uuid
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_members")
}

/// Single-use invite code. Only its SHA-256 is stored (like refresh tokens).
model HouseholdInvite {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  codeHash    String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_invites")
}

model Category {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  type        TransactionType
  color       String?
  icon        String?
  householdId String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([householdId, name, type])
  @@index([householdId, type])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  description String
  /// Money is never stored as float: NUMERIC(14,2) is exact.
  amount      Decimal         @db.Decimal(14, 2)
  type        TransactionType
  date        DateTime        @db.Date
  notes       String?
  categoryId  String          @db.Uuid
  householdId String          @db.Uuid
  /// Who registered it (shown in shared households). Kept if the user leaves.
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Restrict: a category with transactions cannot be deleted by accident.
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Covering index: listing (householdId + date order) and every report
  /// aggregate are answered from the index alone. See LOAD_TESTING.md.
  @@index([householdId, date, type, categoryId, amount], map: "transactions_household_date_covering_idx")
  @@index([householdId, categoryId])
  @@map("transactions")
}

model Budget {
  id           String   @id @default(uuid()) @db.Uuid
  monthlyLimit Decimal  @db.Decimal(14, 2)
  year         Int
  month        Int
  categoryId   String   @db.Uuid
  householdId  String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, year, month])
  @@index([householdId, year, month])
  @@map("budgets")
}
