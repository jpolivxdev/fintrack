# ---- Server ----
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Local: `npm run db:dev` (embedded) or `docker compose up -d db`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fintrack

# ---- Auth ----
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12
